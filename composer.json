{
    "name": "hasyirin/laravel-address",
    "description": "Polymorphic address management for Laravel with hierarchical geographical data and built-in Malaysian dataset.",
    "keywords": [
        "Hasyirin Fakhriy",
        "laravel",
        "laravel-address"
    ],
    "homepage": "https://github.com/hasyirin/laravel-address",
    "license": "MIT",
    "authors": [
        {
            "name": "Hasyirin Fakhriy",
            "email": "ahrim@novarift.my",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^13.35"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.32",
        "nunomaduro/collision": "^8.9.5",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3.5",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.1.1"
    },
    "autoload": {
        "psr-4": {
            "Hasyirin\\Address\\": "src/",
            "Hasyirin\\Address\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hasyirin\\Address\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hasyirin\\Address\\AddressServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
