includes:
    - phpstan-baseline.neon

parameters:
    level: 10
    paths:
        - src
        - config
        - database
        - tests/Fixtures
        - tests/Types
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    ignoreErrors:
        # The seeder works with any configured model and takes its columns as arguments.
        -
            message: '#model property of Illuminate\\Database\\Eloquent\\Model#'
            identifier: argument.type
            path: src/Commands/SeedCommand.php
